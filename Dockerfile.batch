# spectralcrop — Batch inference image (CPU)
#
# Designed for Cloud Run Jobs processing full hyperspectral images.
# Uses pytorch-cpu to avoid CUDA driver requirements inside the container.
#
# Build locally:
#   docker build -f Dockerfile.batch -t spectralcrop-batch:local .
#
# Test locally (requires GCP credentials):
#   docker run --rm \
#     -e GCS_INPUT_BUCKET=spectralcrop-inputs \
#     -e GCS_OUTPUT_BUCKET=spectralcrop-outputs \
#     -e GCS_ENVI_BLOB=raw/2026-05-14/image.hdr \
#     -v ~/.config/gcloud:/root/.config/gcloud:ro \
#     spectralcrop-batch:local

FROM python:3.12-slim

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.11.2 /uv /usr/local/bin/uv

WORKDIR /app

# Install system dependencies required by rasterio, geopandas, and OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgdal-dev \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first (layer-cache friendly)
COPY pyproject.toml uv.lock ./

# Install runtime deps: pytorch-cpu + google-cloud-storage (api extra)
# --no-dev skips test/lint tools, --frozen uses exact versions from uv.lock
RUN uv sync --no-dev --extra pytorch-cpu --extra api --frozen

# Copy source code
COPY spectralcrop/ spectralcrop/
COPY scripts/      scripts/
COPY main.py       .

# google-cloud-storage is not in pyproject.toml yet — install directly
# (will be added in Sprint 2 as a proper dependency)
RUN uv pip install google-cloud-storage --no-deps

# Smoke-test: verify the package imports correctly
RUN uv run python -c "import spectralcrop; import torch; print('OK', torch.__version__)"

ENTRYPOINT ["uv", "run", "python", "scripts/batch_predict.py"]
