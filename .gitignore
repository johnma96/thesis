# ============================================================
# spectralcrop — .gitignore
# ============================================================

# ── uv / Python packaging ────────────────────────────────────
.venv/
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
MANIFEST
dist/
build/
.pybuilder/
__pypackages__/
.pdm.toml
.python-version

# ── Testing / linting caches ─────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.nox/
.tox/

# ── Jupyter ────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── IDEs ───────────────────────────────────────────────────────
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.history/
*.vsix

# ── OS ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Temporary / local files ────────────────────────────────────
temp/
Temp/
temporal/
*.tmp
*.bak
*.swp

# ── Binary data / archives ────────────────────────────────────
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# ── Credentials ───────────────────────────────────────────────
credentials/*
!credentials/.gitkeep
.env
*.env.local

# ── DVC local cache and temp ──────────────────────────────────
# (DVC remote lives on DagsHub — local cache is reproducible from remote)
.dvc/cache/
.dvc/tmp/

# ── MLflow local runs ─────────────────────────────────────────
# (All runs tracked on DagsHub — no local mlruns/)
mlruns/

# ── Large data files (tracked via DVC) ───────────────────────
data/raw/
data/interim/masked_reflectance.zarr/
data/processed/zarr/
# Keep .gitkeep placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# ── Model weights (tracked via DVC) ──────────────────────────
models/*.pt
models/*.pkl
models/*.joblib
# Keep JSON metadata (small, useful for reference)
!models/*.json

# ── Reports — figures and large docs are gitignored except the thesis ─
*.png
*.pdf
# .docx files are NOT tracked — only read-only PDFs are shared via git
reports/*.docx
!reports/figures/arquitectura_cnn2d.png
!reports/Trabajo\ Final\ John\ Montoya.pdf
!reports/Trabajo\ Final\ John\ Montoya\ -\ Observaciones\ jurado.pdf
!reports/Carta\ Respuesta\ -\ Observaciones\ jurado.pdf
!docs/thesis_corrections/*.pdf
!references/theses/*.pdf
!references/papers/*.pdf

# ── Domain data ───────────────────────────────────────────────
*.bsq
*.hdr
*.gpkg
*.qgz
*.tif
# Keep small config TIFFs if any — but data TIFFs are DVC-tracked

# ── Spreadsheets / exports ────────────────────────────────────
*.xlsx
*.xlsb
*.xls
*.gsheet

# ── Django / Flask leftovers (template residue) ──────────────
local_settings.py
db.sqlite3
instance/

# ── Celery ────────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid

# ── Sphinx ────────────────────────────────────────────────────
docs/_build/
/site
